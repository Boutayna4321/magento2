<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Cartware\LoyaltyProgram\Api\LoyaltyBalanceRepositoryInterface"
                type="Cartware\LoyaltyProgram\Model\LoyaltyBalanceRepository"/>

    <preference for="Cartware\LoyaltyProgram\Api\LoyaltyCartManagementInterface"
                type="Cartware\LoyaltyProgram\Model\Checkout\LoyaltyCartManagement"/>

    <type name="Cartware\LoyaltyProgram\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">loyalty</argument>
            <argument name="handlers" xsi:type="array">
                <item name="loyalty" xsi:type="object">Cartware\LoyaltyProgram\Logger\Handler\Loyalty</item>
            </argument>
        </arguments>
    </type>
</config>
