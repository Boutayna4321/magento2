<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="cartware_loyalty_balance" resource="default" engine="innodb"
           comment="Loyalty Program Balance">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false"
                comment="Customer ID"/>
        <column xsi:type="int" name="points" nullable="false" default="0"
                comment="Points Balance"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="CARTWARE_LOYALTY_BALANCE_CUSTOMER_ID">
            <column name="customer_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="CARTWARE_LOYALTY_BALANCE_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="cartware_loyalty_balance" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
    </table>

    <table name="cartware_loyalty_order_points" resource="default" engine="innodb"
           comment="Loyalty Program Points Ledger Per Order">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false"
                comment="Order ID"/>
        <column xsi:type="varchar" name="type" nullable="false" default="earn"
                comment="Ledger Entry Type (earn|deduct)"/>
        <column xsi:type="int" name="points" nullable="false" default="0"
                comment="Points Earned or Deducted (signed)"/>
        <column xsi:type="timestamp" name="created_at" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="CARTWARE_LOYALTY_ORDER_POINTS_ORDER_TYPE">
            <column name="order_id"/>
            <column name="type"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="CARTWARE_LOYALTY_ORDER_POINTS_ORDER_ID_SALES_ORDER_ENTITY_ID"
                    table="cartware_loyalty_order_points" column="order_id"
                    referenceTable="sales_order" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
    </table>

    <table name="quote" resource="checkout" comment="Sales Flat Quote">
        <column xsi:type="int" name="cartware_loyalty_points_used" nullable="true" identity="false"
                default="0" comment="Loyalty Points Used"/>
    </table>
</schema>
