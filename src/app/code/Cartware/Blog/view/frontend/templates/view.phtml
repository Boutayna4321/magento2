<?php
/** @var \Cartware\Blog\Block\Detail $block */
$post = $block->getPost();
?>
<article class="cartware-blog-detail">
    <h1 class="cartware-blog-title"><?= $block->escapeHtml($post->getTitle()) ?></h1>
    <?php if ($post->getAuthor()): ?>
        <p class="cartware-blog-author">
            <?= $block->escapeHtml(__('By %1', $post->getAuthor())) ?>
        </p>
    <?php endif; ?>
    <div class="cartware-blog-content"><?= $block->escapeHtml($post->getContent()) ?></div>
    <p><a href="<?= $block->escapeUrl($block->getUrl('blog')) ?>"><?= $block->escapeHtml(__('Back to blog')) ?></a></p>
</article>
