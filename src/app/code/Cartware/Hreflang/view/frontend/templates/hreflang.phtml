<?php
/** @var Cartware\Hreflang\Block\Hreflang $block */
$links = $block->getAlternateLinks();
?>
<?php if (!empty($links)): ?>
    <?php foreach ($links as $link): ?>
        <link rel="alternate" hreflang="<?= $escaper->escapeHtmlAttr($link['hreflang']) ?>"
              href="<?= $escaper->escapeUrl($link['href']) ?>"/>
    <?php endforeach; ?>
<?php endif; ?>
