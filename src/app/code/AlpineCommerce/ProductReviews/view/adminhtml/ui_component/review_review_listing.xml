<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">review_review_listing.alp_rev_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">review_review_columns</item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="productreviews/review/new"/>
                <class>primary</class>
                <label translate="true">Add New Review</label>
            </button>
        </buttons>
        <spinner>review_review_columns</spinner>
        <deps>
            <dep>review_review_listing.alp_rev_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="alp_rev_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>AlpineCommerce_ProductReviews::review</aclResource>
        <dataProvider class="AlpineCommerce\ProductReviews\Ui\DataProvider\ReviewListingDataProvider"
                      name="alp_rev_listing_data_source">
            <settings>
                <requestFieldName>review_id</requestFieldName>
                <primaryFieldName>review_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete selected reviews?</message>
                        <title translate="true">Delete</title>
                    </confirm>
                    <url path="productreviews/review/deleteList"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <filters name="listing_filters">
            <settings>
                <templates>
                    <filters>
                        <select>
                            <param name="template" xsi:type="string">ui/grid/filters/elements/ui-select</param>
                            <param name="component" xsi:type="string">Magento_Ui/js/form/element/ui-select</param>
                        </select>
                    </filters>
                </templates>
            </settings>
        </filters>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="review_review_columns">
        <column name="review_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="product_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Product ID</label>
            </settings>
        </column>
        <column name="title">
            <settings>
                <filter>text</filter>
                <label translate="true">Title</label>
            </settings>
        </column>
        <column name="rating" component="Magento_Ui/js/grid/columns/statusbar">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Rating</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="AlpineCommerce\ProductReviews\Ui\Source\Status"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="is_verified">
            <settings>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Verified</label>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
            </settings>
        </column>
        <column name="created_at">
            <settings>
                <filter>date</filter>
                <dataType>date</dataType>
                <label translate="true">Created At</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="AlpineCommerce\ProductReviews\Ui\Component\Listing\Column\Actions">
            <settings>
                <indexField>review_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
