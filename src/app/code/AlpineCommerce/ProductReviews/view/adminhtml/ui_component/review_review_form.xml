<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">review_review_form.alp_rev_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Review Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
        <item name="config" xsi:type="array">
            <item name="dataProvider" xsi:type="string">alp_rev_form_data_source</item>
        </item>
    </argument>
    <settings>
        <namespace>review_review_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>review_review_form.alp_rev_form_data_source</dep>
        </deps>
        <buttons>
            <button name="save" class="AlpineCommerce\ProductReviews\Block\Adminhtml\Review\Edit\SaveButton"/>
            <button name="back" class="AlpineCommerce\ProductReviews\Block\Adminhtml\Review\Edit\BackButton"/>
        </buttons>
    </settings>
    <dataSource name="alp_rev_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="provider" xsi:type="string">review_review_form.alp_rev_form_data_source</item>
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    <settings>
            <submitUrl path="productreviews/review/save"/>
        </settings>
        <dataProvider class="AlpineCommerce\ProductReviews\Ui\DataProvider\ReviewFormDataProvider" name="alp_rev_form_data_source">
            <settings>
                <requestFieldName>review_id</requestFieldName>
                <primaryFieldName>review_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="review_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="visible" xsi:type="boolean">false</item>
                </item>
            </argument>
        </field>
        <field name="product_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">review</item>
                    <item name="label" xsi:type="string" translate="true">Product ID</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="dataScope" xsi:type="string">product_id</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="customer_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">review</item>
                    <item name="label" xsi:type="string" translate="true">Customer ID</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="dataScope" xsi:type="string">customer_id</item>
                </item>
            </argument>
        </field>
        <field name="title" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">review</item>
                    <item name="label" xsi:type="string" translate="true">Title</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="dataScope" xsi:type="string">title</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="detail" formElement="textarea">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">review</item>
                    <item name="label" xsi:type="string" translate="true">Detail</item>
                    <item name="dataType" xsi:type="string">textarea</item>
                    <item name="dataScope" xsi:type="string">detail</item>
                    <item name="rows" xsi:type="number">5</item>
                </item>
            </argument>
        </field>
        <field name="rating" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">review</item>
                    <item name="label" xsi:type="string" translate="true">Rating</item>
                    <item name="dataType" xsi:type="string">select</item>
                    <item name="dataScope" xsi:type="string">rating</item>
                    <item name="default" xsi:type="number">0</item>
                </item>
            </argument>
            <settings>
                <dataType>select</dataType>
                <label translate="true">Rating</label>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="AlpineCommerce\ProductReviews\Ui\Source\Rating"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="status" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">review</item>
                    <item name="label" xsi:type="string" translate="true">Status</item>
                    <item name="dataType" xsi:type="string">select</item>
                    <item name="dataScope" xsi:type="string">status</item>
                    <item name="default" xsi:type="number">0</item>
                </item>
            </argument>
            <settings>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="AlpineCommerce\ProductReviews\Ui\Source\Status"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="is_verified" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">review</item>
                    <item name="label" xsi:type="string" translate="true">Verified Purchase</item>
                    <item name="dataType" xsi:type="string">select</item>
                    <item name="dataScope" xsi:type="string">is_verified</item>
                    <item name="default" xsi:type="number">0</item>
                </item>
            </argument>
            <settings>
                <dataType>select</dataType>
                <label translate="true">Verified Purchase</label>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>
