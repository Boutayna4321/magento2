<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="alphacommerce_product_review" resource="default" engine="innodb"
           comment="Product Reviews">
        <column xsi:type="int" name="review_id" unsigned="true" nullable="false" identity="true"
                comment="Review ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false"
                comment="Product ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true"
                comment="Customer ID"/>
        <column xsi:type="varchar" name="title" nullable="false" length="255"
                comment="Title"/>
        <column xsi:type="text" name="detail" nullable="true"
                comment="Detail"/>
        <column xsi:type="smallint" name="rating" unsigned="true" nullable="false"
                comment="Rating (1-5)"/>
        <column xsi:type="smallint" name="status" nullable="false" default="0"
                comment="Status (0=pending, 1=approved, 2=rejected)"/>
        <column xsi:type="smallint" name="is_verified" nullable="false" default="0"
                comment="Is Verified Purchase"/>
        <column xsi:type="timestamp" name="created_at" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="review_id"/>
        </constraint>
        <index referenceId="ALP_REVIEW_PRODUCT_ID" indexType="btree">
            <column name="product_id"/>
        </index>
        <index referenceId="ALP_REVIEW_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="ALP_REVIEW_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>

    <table name="alphacommerce_product_review_image" resource="default" engine="innodb"
           comment="Product Review Images">
        <column xsi:type="int" name="image_id" unsigned="true" nullable="false" identity="true"
                comment="Image ID"/>
        <column xsi:type="int" name="review_id" unsigned="true" nullable="false"
                comment="Review ID"/>
        <column xsi:type="varchar" name="image_path" nullable="false" length="255"
                comment="Image Path"/>
        <column xsi:type="smallint" name="status" nullable="false" default="0"
                comment="Status (0=pending, 1=approved)"/>
        <column xsi:type="timestamp" name="created_at" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="image_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ALP_REVIEW_IMAGE_REVIEW_ID"
                    table="alphacommerce_product_review_image"
                    column="review_id"
                    referenceTable="alphacommerce_product_review"
                    referenceColumn="review_id"
                    onDelete="CASCADE"/>
        <index referenceId="ALP_REVIEW_IMAGE_REVIEW_ID_IDX" indexType="btree">
            <column name="review_id"/>
        </index>
    </table>

    <table name="alphacommerce_product_review_helpful" resource="default" engine="innodb"
           comment="Product Review Helpful Votes">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="int" name="review_id" unsigned="true" nullable="false"
                comment="Review ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true"
                comment="Customer ID"/>
        <column xsi:type="smallint" name="helpful" nullable="false" default="0"
                comment="Helpful (0=not helpful, 1=helpful)"/>
        <column xsi:type="timestamp" name="created_at" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ALP_REVIEW_HELPFUL_REVIEW_ID"
                    table="alphacommerce_product_review_helpful"
                    column="review_id"
                    referenceTable="alphacommerce_product_review"
                    referenceColumn="review_id"
                    onDelete="CASCADE"/>
        <index referenceId="ALP_REVIEW_HELPFUL_REVIEW_ID_IDX" indexType="btree">
            <column name="review_id"/>
        </index>
        <index referenceId="ALP_REVIEW_HELPFUL_CUSTOMER_ID_IDX" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>
</schema>
