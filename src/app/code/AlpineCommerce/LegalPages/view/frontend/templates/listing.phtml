<?php
/** @var \AlpineCommerce\LegalPages\Block\Listing $block */
$pages = $block->getPages();
?>
<?php if ($pages): ?>
    <div class="alphacommerce-legal-list">
        <?php foreach ($pages as $page): ?>
            <div class="alphacommerce-legal-item">
                <h2 class="alphacommerce-legal-title">
                    <a href="<?= $block->escapeUrl($block->getPageUrl($page)) ?>">
                        <?= $block->escapeHtml($page->getTitle()) ?>
                    </a>
                </h2>
                <div class="alphacommerce-legal-type">
                    <?= $block->escapeHtml($page->getType()) ?>
                </div>
            </div>
        <?php endforeach; ?>
    </div>
<?php else: ?>
    <p><?= $block->escapeHtml(__('No legal pages yet.')) ?></p>
<?php endif; ?>
