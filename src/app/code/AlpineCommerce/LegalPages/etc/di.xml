<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="AlpineCommerce\LegalPages\Api\Data\LegalPageInterface"
                type="AlpineCommerce\LegalPages\Model\LegalPage"/>
    <preference for="AlpineCommerce\LegalPages\Api\Data\LegalPageSearchResultsInterface"
                type="AlpineCommerce\LegalPages\Model\LegalPageSearchResults"/>
    <preference for="AlpineCommerce\LegalPages\Api\LegalPageRepositoryInterface"
                type="AlpineCommerce\LegalPages\Model\LegalPageRepository"/>
    <preference for="AlpineCommerce\LegalPages\Api\LegalPageRestInterface"
                type="AlpineCommerce\LegalPages\Model\Rest\LegalPageRestService"/>

    <virtualType name="legal_page_listing_data_source"
                 type="AlpineCommerce\LegalPages\Ui\DataProvider\ListingDataProvider">
        <arguments>
            <argument name="name" xsi:type="string">legal_page_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">page_id</argument>
            <argument name="requestFieldName" xsi:type="string">page_id</argument>
        </arguments>
    </virtualType>

    <virtualType name="legal_page_form_data_source"
                 type="AlpineCommerce\LegalPages\Ui\DataProvider\FormDataProvider">
        <arguments>
            <argument name="name" xsi:type="string">legal_page_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">page_id</argument>
            <argument name="requestFieldName" xsi:type="string">page_id</argument>
        </arguments>
    </virtualType>
</config>
