<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/alphacommerce/legal-pages" method="GET">
        <service class="AlpineCommerce\LegalPages\Api\LegalPageRestInterface" method="getPages"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/alphacommerce/legal-pages/{type}" method="GET">
        <service class="AlpineCommerce\LegalPages\Api\LegalPageRestInterface" method="getPageByType"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
