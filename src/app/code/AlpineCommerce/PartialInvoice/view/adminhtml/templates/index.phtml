<?php /** @var \Magento\Framework\Escaper $escaper */ ?>
<?php /** @var $block \AlpineCommerce\PartialInvoice\Block\Adminhtml\Index */ ?>
<?php $invoices = $block->getInvoices(); ?>

<div class="admin__data-grid-wrap" data-role="grid">
    <table class="data-grid">
        <thead>
            <tr>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Invoice #')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Order #')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Customer')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Items')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Amount')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Status')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Created At')) ?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($invoices as $invoice): ?>
                <?php
                    $order = $invoice->getOrder();
                    $customerName = $order ? $order->getCustomerName() : __('Guest');
                ?>
                <tr>
                    <td class="data-grid-td"><?= $escaper->escapeHtml($invoice->getIncrementId()) ?></td>
                    <td class="data-grid-td"><?= $escaper->escapeHtml($order ? $order->getIncrementId() : __('N/A')) ?></td>
                    <td class="data-grid-td"><?= $escaper->escapeHtml($customerName) ?></td>
                    <td class="data-grid-td"><?= (int) $invoice->getTotalQty() ?></td>
                    <td class="data-grid-td"><?= $escaper->escapeHtml($order ? $order->getBaseCurrency()->formatTxt($invoice->getBaseGrandTotal()) : $invoice->getBaseGrandTotal()) ?></td>
                    <td class="data-grid-td"><?= $escaper->escapeHtml($invoice->getState() ? __('Paid') : __('Pending')) ?></td>
                    <td class="data-grid-td"><?= $escaper->escapeHtml($block->formatDate($invoice->getCreatedAt())) ?></td>
                </tr>
            <?php endforeach; ?>
            <?php if (!$invoices->getSize()): ?>
                <tr>
                    <td colspan="7" class="data-grid-td"><?= $escaper->escapeHtml(__('No partial invoices found.')) ?></td>
                </tr>
            <?php endif; ?>
        </tbody>
    </table>
</div>
