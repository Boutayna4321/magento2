<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/alphacommerce/blog/posts" method="GET">
        <service class="AlpineCommerce\Blog\Api\BlogRestInterface" method="getPosts"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/alphacommerce/blog/posts/{postId}" method="GET">
        <service class="AlpineCommerce\Blog\Api\BlogRestInterface" method="getPost"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/alphacommerce/blog/categories" method="GET">
        <service class="AlpineCommerce\Blog\Api\BlogRestInterface" method="getCategories"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/alphacommerce/blog/categories/{categoryId}" method="GET">
        <service class="AlpineCommerce\Blog\Api\BlogRestInterface" method="getCategory"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
