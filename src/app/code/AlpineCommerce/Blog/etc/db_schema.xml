<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="alphacommerce_blog_category" resource="default" engine="innodb"
           comment="Blog Category" charset="utf8mb4" collation="utf8mb4_general_ci">
        <column xsi:type="int" name="category_id" unsigned="true" nullable="false" identity="true"
                comment="Category ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="varchar" name="url_key" nullable="false" length="255" comment="URL Key"/>
        <column xsi:type="smallint" name="sort_order" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="smallint" name="is_active" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="category_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ALPINECOMMERCE_BLOG_CATEGORY_URL_KEY">
            <column name="url_key"/>
        </constraint>
        <index referenceId="ALPINECOMMERCE_BLOG_CATEGORY_IS_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>
    </table>
    <table name="alphacommerce_blog_post" resource="default" engine="innodb"
           comment="Blog Post" charset="utf8mb4" collation="utf8mb4_general_ci">
        <column xsi:type="int" name="post_id" unsigned="true" nullable="false" identity="true"
                comment="Post ID"/>
        <column xsi:type="varchar" name="title" nullable="false" length="255" comment="Title"/>
        <column xsi:type="text" name="content" nullable="true" comment="Content"/>
        <column xsi:type="varchar" name="url_key" nullable="false" length="255" comment="URL Key"/>
        <column xsi:type="int" name="category_id" unsigned="true" nullable="true" comment="Category ID"/>
        <column xsi:type="varchar" name="author" nullable="true" length="100" comment="Author"/>
        <column xsi:type="smallint" name="sort_order" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="smallint" name="is_active" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="post_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ALPINECOMMERCE_BLOG_POST_URL_KEY">
            <column name="url_key"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ALPINECOMMERCE_BLOG_POST_CATEGORY_CATEGORY_ID"
                    table="alphacommerce_blog_post" column="category_id"
                    referenceTable="alphacommerce_blog_category" referenceColumn="category_id"
                    onDelete="SET NULL"/>
        <index referenceId="ALPINECOMMERCE_BLOG_POST_IS_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>
        <index referenceId="ALPINECOMMERCE_BLOG_POST_CATEGORY_ID" indexType="btree">
            <column name="category_id"/>
        </index>
    </table>
</schema>
