<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="alphacommerce_store_locator_store" resource="default" engine="innodb"
           comment="Store Locator - Store">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Store Name"/>
        <column xsi:type="varchar" name="street" nullable="true" length="255" comment="Street Address"/>
        <column xsi:type="varchar" name="city" nullable="true" length="255" comment="City"/>
        <column xsi:type="varchar" name="region" nullable="true" length="255" comment="Region/State"/>
        <column xsi:type="varchar" name="postcode" nullable="true" length="32" comment="Postcode"/>
        <column xsi:type="varchar" name="country_id" nullable="true" length="2" comment="Country Code"/>
        <column xsi:type="varchar" name="phone" nullable="true" length="32" comment="Phone"/>
        <column xsi:type="decimal" name="latitude" precision="11" scale="6" nullable="true" comment="Latitude"/>
        <column xsi:type="decimal" name="longitude" precision="11" scale="6" nullable="true" comment="Longitude"/>
        <column xsi:type="text" name="opening_hours" nullable="true" comment="Opening Hours"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ALPINECOMMERCE_STORE_LOCATOR_STORE_IS_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>
    </table>
</schema>
