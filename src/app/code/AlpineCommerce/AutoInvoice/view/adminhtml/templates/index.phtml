<h3>How it works</h3>
<ol>
    <li>Customer places an order</li>
    <li>Observer <code>checkout_onepage_controller_success_action</code> is triggered</li>
    <li>If enabled, an invoice is automatically created</li>
    <li>Invoice is marked as paid</li>
    <li>Order status changes from <code>pending_payment</code> to <code>processing</code></li>
</ol>

<h3>Quick Links</h3>
<ul>
    <li><a href="<?= $block->escapeUrl($block->getInvoiceUrl()) ?>">View All Invoices</a></li>
    <li><a href="<?= $block->escapeUrl($block->getOrderUrl()) ?>">View All Orders</a></li>
</ul>

<h3>Recent Orders</h3>
<?php
$orders = $block->getRecentOrders(10);
?>

<table class="auto-invoice-data-table">
    <tr>
        <th>Order ID</th>
        <th>Status</th>
        <th>Grand Total</th>
        <th>Created At</th>
    </tr>
    <?php foreach ($orders as $order): ?>
    <tr>
        <td><?= $block->escapeHtml($order->getIncrementId()) ?></td>
        <td><?= $block->escapeHtml($order->getStatus()) ?></td>
        <td><?= $block->escapeHtml($order->getBaseGrandTotal()) ?></td>
        <td><?= $block->escapeHtml($order->getCreatedAt()) ?></td>
    </tr>
    <?php endforeach; ?>
</table>
