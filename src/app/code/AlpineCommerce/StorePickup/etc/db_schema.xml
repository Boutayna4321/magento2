<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote" resource="default" engine="innodb" comment="Sales Flat Quote">
        <column xsi:type="varchar" name="alphacommerce_pickup_source_code" length="255" nullable="true" comment="AlpineCommerce Store Pickup Source"/>
    </table>
    <table name="sales_order" resource="default" engine="innodb" comment="Sales Flat Order">
        <column xsi:type="varchar" name="alphacommerce_pickup_source_code" length="255" nullable="true" comment="AlpineCommerce Store Pickup Source"/>
    </table>
    <table name="alphacommerce_pickup_store_info" resource="default" engine="innodb" comment="AlpineCommerce Store Pickup - extra info per MSI source">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="source_code" length="255" nullable="false" comment="MSI Source Code"/>
        <column xsi:type="varchar" name="name" length="255" nullable="false" comment="Store Name"/>
        <column xsi:type="varchar" name="street" length="255" nullable="true" comment="Street Address"/>
        <column xsi:type="varchar" name="city" length="255" nullable="true" comment="City"/>
        <column xsi:type="varchar" name="region" length="255" nullable="true" comment="Region"/>
        <column xsi:type="varchar" name="postcode" length="32" nullable="true" comment="Postcode"/>
        <column xsi:type="varchar" name="country_id" length="2" nullable="true" comment="Country Code"/>
        <column xsi:type="varchar" name="phone" length="32" nullable="true" comment="Phone"/>
        <column xsi:type="decimal" name="latitude" precision="11" scale="6" nullable="true" comment="Latitude"/>
        <column xsi:type="decimal" name="longitude" precision="11" scale="6" nullable="true" comment="Longitude"/>
        <column xsi:type="text" name="opening_hours" nullable="true" comment="Opening Hours"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ALPINECOMMERCE_PICKUP_STORE_INFO_SOURCE_CODE">
            <column name="source_code"/>
        </constraint>
        <index referenceId="ALPINECOMMERCE_PICKUP_STORE_INFO_IS_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>
    </table>
</schema>
