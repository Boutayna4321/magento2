<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <!-- ============================================ -->
        <!-- STORE SETUP MODULE CONFIGURATION             -->
        <!-- ============================================ -->
        <storesetup>
            <general>
                <enabled>1</enabled>
                <display_store_info>1</display_store_info>
            </general>
        </storesetup>

        <!-- ============================================ -->
        <!-- DEFAULT WEBSITE - UK (English)               -->
        <!-- ============================================ -->
        <general>
            <locale>
                <code>en_GB</code>
            </locale>
            <country>
                <default>GB</default>
            </country>
        </general>
        <currency>
            <options>
                <default>GBP</default>
                <allow>GBP,EUR</allow>
            </options>
        </currency>

        <!-- ============================================ -->
        <!-- CATALOG PRICE SCOPE - Website                -->
        <!-- ============================================ -->
        <catalog>
            <price>
                <scope>1</scope>
            </price>
        </catalog>

        <!-- ============================================ -->
        <!-- PAYMENT METHODS DEFAULTS                     -->
        <!-- ============================================ -->
        <payment>
            <checkmo>
                <active>1</active>
                <title>Check / Money Order</title>
                <order_status>processing</order_status>
                <sort_order>10</sort_order>
            </checkmo>
            <banktransfer>
                <active>1</active>
                <title>Bank Transfer</title>
                <sort_order>20</sort_order>
            </banktransfer>
        </payment>

        <!-- ============================================ -->
        <!-- SHIPPING METHODS DEFAULTS                    -->
        <!-- ============================================ -->
        <carriers>
            <flatrate>
                <active>1</active>
                <title>Flat Rate</title>
                <type>O</type>
                <price>5.00</price>
            </flatrate>
            <freeshipping>
                <active>1</active>
                <title>Free Shipping</title>
                <free_shipping_subtract>1</free_shipping_subtract>
                <free_shipping_subtotal>50.00</free_shipping_subtotal>
            </freeshipping>
            <tablerate>
                <active>0</active>
            </tablerate>
        </carriers>
    </default>

    <!-- ============================================ -->
    <!-- FRENCH STORE VIEW (french) - fr_FR, EUR      -->
    <!-- ============================================ -->
    <stores>
        <french>
            <general>
                <locale>
                    <code>fr_FR</code>
                </locale>
                <country>
                    <default>FR</default>
                </country>
            </general>
            <currency>
                <options>
                    <default>EUR</default>
                </options>
            </currency>
        </french>

        <!-- ============================================ -->
        <!-- GERMAN STORE VIEW (german) - de_DE, EUR      -->
        <!-- ============================================ -->
        <german>
            <general>
                <locale>
                    <code>de_DE</code>
                </locale>
                <country>
                    <default>DE</default>
                </country>
            </general>
            <currency>
                <options>
                    <default>EUR</default>
                </options>
            </currency>
        </german>

        <!-- ============================================ -->
        <!-- SPANISH STORE VIEW (spanish) - es_ES, EUR    -->
        <!-- ============================================ -->
        <spanish>
            <general>
                <locale>
                    <code>es_ES</code>
                </locale>
                <country>
                    <default>ES</default>
                </country>
            </general>
            <currency>
                <options>
                    <default>EUR</default>
                </options>
            </currency>
        </spanish>

        <!-- ============================================ -->
        <!-- DEFAULT FRENCH (default_fr) - fr_FR, EUR     -->
        <!-- ============================================ -->
        <default_fr>
            <general>
                <locale>
                    <code>fr_FR</code>
                </locale>
                <country>
                    <default>GB</default>
                </country>
            </general>
            <currency>
                <options>
                    <default>EUR</default>
                </options>
            </currency>
        </default_fr>
    </stores>
</config>
