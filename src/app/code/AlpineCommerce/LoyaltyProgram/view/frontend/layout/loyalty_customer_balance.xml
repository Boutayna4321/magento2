<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="2columns-left"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">My loyalty points</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="AlpineCommerce\LoyaltyProgram\Block\Customer\Balance"
                   name="loyalty_customer_balance"
                   template="AlpineCommerce_LoyaltyProgram::customer/balance.phtml"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
