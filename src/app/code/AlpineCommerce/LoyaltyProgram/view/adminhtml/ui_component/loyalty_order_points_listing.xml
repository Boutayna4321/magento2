<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">loyalty_order_points_listing.loyalty_order_points_listing_data_source</item>
            <item name="deps" xsi:type="string">loyalty_order_points_listing.loyalty_order_points_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>loyalty_order_points_columns</spinner>
        <deps>
            <dep>loyalty_order_points_listing.loyalty_order_points_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="loyalty_order_points_listing_data_source" component="Magento_Ui/js/grid/provider">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">AlpineCommerce\LoyaltyProgram\Ui\DataProvider\OrderPoints\Listing</argument>
            <argument name="name" xsi:type="string">loyalty_order_points_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="collectionFactory" xsi:type="object">AlpineCommerce\LoyaltyProgram\Model\ResourceModel\LoyaltyOrderPoints\GridCollectionFactory</argument>
        </argument>
        <settings>
            <updateUrl path="mui/index/render"/>
            <filterUrlParams>
                <param name="customer_id">*</param>
            </filterUrlParams>
        </settings>
        <aclResource>AlpineCommerce_LoyaltyProgram::balance</aclResource>
    </dataSource>
    <columns name="loyalty_order_points_columns">
        <column name="entity_id">
            <settings>
                <filter>text</filter>
                <sorting>asc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="order_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Order ID</label>
            </settings>
        </column>
        <column name="type" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Type</label>
            </settings>
        </column>
        <column name="points">
            <settings>
                <filter>text</filter>
                <label translate="true">Points</label>
            </settings>
        </column>
        <column name="created_at">
            <settings>
                <filter>date</filter>
                <label translate="true">Date</label>
            </settings>
        </column>
    </columns>
    <paging name="listing_paging"/>
</listing>
