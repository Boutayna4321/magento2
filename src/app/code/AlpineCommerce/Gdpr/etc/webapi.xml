<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/alphacommerce/gdpr/consent" method="POST">
        <service class="AlpineCommerce\Gdpr\Api\GdprRestInterface" method="logConsent"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/alphacommerce/gdpr/export" method="GET">
        <service class="AlpineCommerce\Gdpr\Api\GdprRestInterface" method="exportData"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
    <route url="/V1/alphacommerce/gdpr/delete" method="DELETE">
        <service class="AlpineCommerce\Gdpr\Api\GdprRestInterface" method="deleteData"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
</routes>
