<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="alphacommerce_gdpr_consent_log" resource="default" engine="innodb"
           comment="GDPR Consent Log">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true"
                comment="Customer ID (null for guests)"/>
        <column xsi:type="varchar" name="consent_type" nullable="false" length="64"
                comment="Consent Type (cookies|newsletter|terms|privacy)"/>
        <column xsi:type="boolean" name="status" nullable="false" default="1"
                comment="Granted (1) or Revoked (0)"/>
        <column xsi:type="varchar" name="ip_address" nullable="true" length="45"
                comment="IP Address"/>
        <column xsi:type="varchar" name="user_agent" nullable="true" length="255"
                comment="User Agent"/>
        <column xsi:type="timestamp" name="created_at" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ALPINECOMMERCE_GDPR_CONSENT_LOG_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="ALPINECOMMERCE_GDPR_CONSENT_LOG_TYPE" indexType="btree">
            <column name="consent_type"/>
        </index>
    </table>
</schema>
