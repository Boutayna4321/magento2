<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/customercare/vip-status/:customerId" method="GET">
        <service class="AlpineCommerce\CustomerCare\Api\CustomerCareInterface" method="getVipStatus"/>
        <resources>
            <resource ref="AlpineCommerce_CustomerCare::manage"/>
        </resources>
    </route>
    <route url="/V1/customercare/me/vip-status" method="GET">
        <service class="AlpineCommerce\CustomerCare\Api\CustomerCareInterface" method="getVipStatus"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="customerId" force="true">%customer_id%</parameter>
        </data>
    </route>
    <route url="/V1/customercare/vip-status/:customerId" method="POST">
        <service class="AlpineCommerce\CustomerCare\Api\CustomerCareInterface" method="recalculateVipStatus"/>
        <resources>
            <resource ref="AlpineCommerce_CustomerCare::manage"/>
        </resources>
    </route>
    <route url="/V1/customercare/recalculate-all" method="POST">
        <service class="AlpineCommerce\CustomerCare\Api\CustomerCareInterface" method="recalculateAll"/>
        <resources>
            <resource ref="AlpineCommerce_CustomerCare::manage"/>
        </resources>
    </route>
</routes>
