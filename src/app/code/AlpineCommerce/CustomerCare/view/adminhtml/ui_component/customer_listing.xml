<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <columns name="customer_columns">
        <column name="customer_type" sortOrder="70">
            <settings>
                <filter>select</filter>
                <options class="AlpineCommerce\CustomerCare\Model\Attribute\Source\CustomerType"/>
                <label translate="true">Customer Type</label>
            </settings>
        </column>
        <column name="vip_level" sortOrder="80">
            <settings>
                <filter>select</filter>
                <options class="AlpineCommerce\CustomerCare\Model\Attribute\Source\VipLevelSource"/>
                <label translate="true">VIP Level</label>
            </settings>
        </column>
        <column name="lifetime_spent" sortOrder="90">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Lifetime Spent</label>
            </settings>
        </column>
    </columns>
</listing>
