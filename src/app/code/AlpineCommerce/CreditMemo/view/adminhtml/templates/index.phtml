<?php /** @var \Magento\Framework\Escaper $escaper */ ?>
<?php /** @var $block \AlpineCommerce\CreditMemo\Block\Adminhtml\Index */ ?>
<?php $creditMemos = $block->getCreditMemos(); ?>

<div class="admin__data-grid-wrap" data-role="grid">
    <table class="data-grid">
        <thead>
            <tr>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Credit Memo #')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Order #')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Customer')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Amount')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Status')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Created At')) ?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($creditMemos as $creditMemo): ?>
                <?php
                    $order = $creditMemo->getOrder();
                    $customerName = $order ? $order->getCustomerName() : __('Guest');
                ?>
                <tr>
                    <td class="data-grid-td"><?= $escaper->escapeHtml($creditMemo->getIncrementId()) ?></td>
                    <td class="data-grid-td"><?= $escaper->escapeHtml($order ? $order->getIncrementId() : __('N/A')) ?></td>
                    <td class="data-grid-td"><?= $escaper->escapeHtml($customerName) ?></td>
                    <td class="data-grid-td"><?= $escaper->escapeHtml($order ? $order->getBaseCurrency()->formatTxt($creditMemo->getBaseGrandTotal()) : $creditMemo->getBaseGrandTotal()) ?></td>
                    <td class="data-grid-td"><?= $escaper->escapeHtml($creditMemo->getState() ? __('Refunded') : __('Pending')) ?></td>
                    <td class="data-grid-td"><?= $escaper->escapeHtml($block->formatDate($creditMemo->getCreatedAt())) ?></td>
                </tr>
            <?php endforeach; ?>
            <?php if (!$creditMemos->getSize()): ?>
                <tr>
                    <td colspan="6" class="data-grid-td"><?= $escaper->escapeHtml(__('No credit memos found.')) ?></td>
                </tr>
            <?php endif; ?>
        </tbody>
    </table>
</div>
