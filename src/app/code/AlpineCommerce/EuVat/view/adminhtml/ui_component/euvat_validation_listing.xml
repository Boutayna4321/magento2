<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">euvat_validation_listing.euvat_validation_listing_data_source</item>
            <item name="蒙蒙" xsi:type="string">euvat_validation_listing</item>
        </item>
        <item name="spinner" xsi:type="string">spinner</item>
        <item name="buttons" xsi:type="array">
            <item name="validate" xsi:type="array">
                <item name="name" xsi:type="string">validate</item>
                <item name="label" xsi:type="string">Validate New VAT</item>
                <item name="class" xsi:type="string">primary</item>
                <item name="url" xsi:type="string">*/*/validate</item>
            </item>
        </item>
    </argument>
    <dataSource name="euvat_validation_listing_data_source" component="Magento_Ui/js/grid/provider">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="update_url" xsi:type="url" path="mui/index/render"/>
                <item name="storageConfig" xsi:type="array">
                    <item name="indexField" xsi:type="string">entity_id</item>
                </item>
            </item>
        </argument>
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">AlpineCommerce\EuVat\Ui\DataProvider\ValidationDataProvider</argument>
            <argument name="name" xsi:type="string">euvat_validation_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="spinner" xsi:type="string">spinner</item>
                </item>
            </argument>
        </argument>
    </dataSource>
    <container name="landing_data">
        <argument name="data" xsi:type="array">
            <item name="spinner" xsi:type="string">spinner</item>
        </argument>
        <column name="entity_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">textRange</item>
                    <item name="sorting" xsi:type="string">asc</item>
                    <item name="label" xsi:type="string">ID</item>
                </item>
            </argument>
        </column>
        <column name="country_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" xsi:type="string">Country</item>
                </item>
            </argument>
        </column>
        <column name="vat_number">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" xsi:type="string">VAT Number</item>
                </item>
            </argument>
        </column>
        <column name="is_valid">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">select</item>
                    <item name="options" xsi:type="array">
                        <item name="1" xsi:type="array">
                            <item name="value" xsi:type="string">1</item>
                            <item name="label" xsi:type="string">Valid</item>
                        </item>
                        <item name="0" xsi:type="array">
                            <item name="value" xsi:type="string">0</item>
                            <item name="label" xsi:type="string">Invalid</item>
                        </item>
                    </item>
                    <item name="label" xsi:type="string">Status</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/columns/select</item>
                </item>
            </argument>
        </column>
        <column name="name">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" xsi:type="string">Company Name</item>
                </item>
            </argument>
        </column>
        <column name="request_date">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">textRange</item>
                    <item name="label" xsi:type="string">Request Date</item>
                </item>
            </argument>
        </column>
        <column name="created_at">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">textRange</item>
                    <item name="label" xsi:type="string">Validated At</item>
                </item>
            </argument>
        </column>
        <column name="actions" class="AlpineCommerce\EuVat\Ui\Component\Listing\Column\ValidationActions">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string">Actions</item>
                    <item name="sortable" xsi:type="boolean">false</item>
                </item>
            </argument>
        </column>
    </container>
</listing>
