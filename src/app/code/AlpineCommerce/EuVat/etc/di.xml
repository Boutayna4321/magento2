<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="AlpineCommerce\EuVat\Api\VatValidationInterface"
                type="AlpineCommerce\EuVat\Model\VatValidationService"/>
    <preference for="AlpineCommerce\EuVat\Api\VatValidationRepositoryInterface"
                type="AlpineCommerce\EuVat\Model\VatValidationRepository"/>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="alphacommerce_euvat_validate" xsi:type="object">
                    AlpineCommerce\EuVat\Console\Command\ValidateVatCommand
                </item>
            </argument>
        </arguments>
    </type>
</config>
