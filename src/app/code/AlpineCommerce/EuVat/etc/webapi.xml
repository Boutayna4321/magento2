<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/alphacommerce/euvat/validate" method="POST">
        <service class="AlpineCommerce\EuVat\Api\VatValidationInterface" method="validate"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/alphacommerce/euvat/validate/:countryId/:vatNumber" method="GET">
        <service class="AlpineCommerce\EuVat\Api\VatValidationInterface" method="getByCountryAndNumber"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
