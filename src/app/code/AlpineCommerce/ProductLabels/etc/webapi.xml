<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/alphacommerce/product-labels" method="GET">
        <service class="AlpineCommerce\ProductLabels\Api\ProductLabelRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="admin"/>
        </resources>
    </route>
    <route url="/V1/alphacommerce/product-labels" method="POST">
        <service class="AlpineCommerce\ProductLabels\Api\ProductLabelRepositoryInterface" method="save"/>
        <resources>
            <resource ref="admin"/>
        </resources>
    </route>
    <route url="/V1/alphacommerce/product-labels/:id" method="GET">
        <service class="AlpineCommerce\ProductLabels\Api\ProductLabelRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="admin"/>
        </resources>
    </route>
    <route url="/V1/alphacommerce/product-labels/:id" method="PUT">
        <service class="AlpineCommerce\ProductLabels\Api\ProductLabelRepositoryInterface" method="save"/>
        <resources>
            <resource ref="admin"/>
        </resources>
    </route>
    <route url="/V1/alphacommerce/product-labels/:id" method="DELETE">
        <service class="AlpineCommerce\ProductLabels\Api\ProductLabelRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="admin"/>
        </resources>
    </route>
    <route url="/V1/alphacommerce/product-labels/:id/apply" method="POST">
        <service class="AlpineCommerce\ProductLabels\Api\ProductLabelRepositoryInterface" method="assignLabelsToProduct"/>
        <resources>
            <resource ref="admin"/>
        </resources>
    </route>
</routes>
