<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="alphacommerce_product_label" resource="default" engine="innodb"
           comment="Product Labels">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Label Name"/>
        <column xsi:type="varchar" name="code" nullable="false" length="100" comment="Label Code (unique identifier)"/>
        <column xsi:type="varchar" name="color" nullable="true" length="7" comment="Background Color (hex)"/>
        <column xsi:type="varchar" name="text_color" nullable="true" length="7" comment="Text Color (hex)"/>
        <column xsi:type="smallint" name="priority" nullable="false" default="0" comment="Display Priority"/>
        <column xsi:type="varchar" name="position" nullable="false" default="top-left" comment="Position"/>
        <column xsi:type="varchar" name="icon" nullable="true" length="255" comment="Icon URL or CSS class"/>
        <column xsi:type="datetime" name="start_date" nullable="true" comment="Start Date"/>
        <column xsi:type="datetime" name="end_date" nullable="true" comment="End Date"/>
        <column xsi:type="boolean" name="is_active" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ALPINECOMMERCE_PRODUCT_LABEL_CODE">
            <column name="code"/>
        </constraint>
        <index referenceId="ALPINECOMMERCE_PRODUCT_LABEL_IS_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>
    </table>

    <table name="alphacommerce_product_label_product" resource="default" engine="innodb"
           comment="Product Label Assignments">
        <column xsi:type="int" name="label_id" unsigned="true" nullable="false" comment="Label ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" comment="Product ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="label_id"/>
            <column name="product_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="ALPINECOMMERCE_PRODUCT_LABEL_PRODUCT_LABEL_ID"
                    table="alphacommerce_product_label_product" column="label_id"
                    referenceTable="alphacommerce_product_label" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="ALPINECOMMERCE_PRODUCT_LABEL_PRODUCT_PRODUCT_ID"
                    table="alphacommerce_product_label_product" column="product_id"
                    referenceTable="catalog_product_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
    </table>
</schema>
