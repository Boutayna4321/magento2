<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">productlabels_label_grid.productlabels_label_grid_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="productlabels/label/edit"/>
                <class>primary</class>
                <label translate="true">Add New Label</label>
            </button>
        </buttons>
        <spinner>productlabels_label_grid_columns</spinner>
        <deps>
            <dep>productlabels_label_grid.productlabels_label_grid_data_source</dep>
        </deps>
    </settings>
    <dataSource name="productlabels_label_grid_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>AlpineCommerce_ProductLabels::labels</aclResource>
        <dataProvider class="AlpineCommerce\ProductLabels\Ui\DataProvider\ProductLabelListingDataProvider"
                      name="productlabels_label_grid_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete selected items?</message>
                        <title translate="true">Delete items</title>
                    </confirm>
                    <url path="productlabels/label/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
            <action name="status">
                <settings>
                    <type>status</type>
                    <label translate="true">Change status</label>
                    <actions>
                        <action name="1">
                            <type>enable</type>
                            <label translate="true">Enable</label>
                            <url path="productlabels/label/massStatus">
                                <param name="status">1</param>
                            </url>
                        </action>
                        <action name="0">
                            <type>disable</type>
                            <label translate="true">Disable</label>
                            <url path="productlabels/label/massStatus">
                                <param name="status">0</param>
                            </url>
                        </action>
                    </actions>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="productlabels_label_grid_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">productlabels_label_grid.productlabels_label_grid.productlabels_label_grid_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">edit</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Label Name</label>
            </settings>
        </column>
        <column name="code" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Code</label>
            </settings>
        </column>
        <column name="priority" sortOrder="40">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Priority</label>
            </settings>
        </column>
        <column name="position" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="AlpineCommerce\ProductLabels\Ui\Source\Position"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Position</label>
            </settings>
        </column>
        <column name="is_active" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="AlpineCommerce\ProductLabels\Ui\Source\Enabled"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="AlpineCommerce\ProductLabels\Ui\Component\Listing\Column\Actions" sortOrder="70">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
