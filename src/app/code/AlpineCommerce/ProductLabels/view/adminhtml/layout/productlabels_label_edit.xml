<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="AlpineCommerce\ProductLabels\Block\Adminhtml\Label\Edit" name="productlabels_label_edit" template="AlpineCommerce_ProductLabels::label/edit.phtml">
                <block class="AlpineCommerce\ProductLabels\Block\Adminhtml\Label\Edit\Form" name="form" as="form">
                    <arguments>
                        <argument name="action" xsi:type="string">productlabels/label/save</argument>
                    </arguments>
                    <block class="AlpineCommerce\ProductLabels\Block\Adminhtml\Label\Edit\Tab\Products" name="products_grid" as="products_grid"/>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>
