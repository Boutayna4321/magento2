<?php
/** @var \AlpineCommerce\Faq\Block\Listing $block */
$faqs = $block->getFaqs();
?>
<?php if ($faqs): ?>
    <div class="alphacommerce-faq-list">
        <?php foreach ($faqs as $faq): ?>
            <div class="alphacommerce-faq-item">
                <h2 class="alphacommerce-faq-title">
                    <a href="<?= $block->escapeUrl($block->getFaqUrl($faq)) ?>">
                        <?= $block->escapeHtml($faq->getTitle()) ?>
                    </a>
                </h2>
                <div class="alphacommerce-faq-content">
                    <?= $block->escapeHtml($faq->getContent()) ?>
                </div>
            </div>
        <?php endforeach; ?>
    </div>
<?php else: ?>
    <p><?= $block->escapeHtml(__('No FAQ entries yet.')) ?></p>
<?php endif; ?>
