<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/alphacommerce/faqs" method="GET">
        <service class="AlpineCommerce\Faq\Api\FaqRestInterface" method="getFaqs"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/alphacommerce/faqs/{faqId}" method="GET">
        <service class="AlpineCommerce\Faq\Api\FaqRestInterface" method="getFaq"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
