# Magento 2 Docker Environment — copy to .env and adjust
#
# cp .env.example .env
#
# Pin the compose project name so volume/network names do not change if the
# directory is renamed or cloned to a second path. Two checkouts of this repo
# with different directory names will otherwise create two independent stacks
# that fight over the same host ports.
COMPOSE_PROJECT_NAME=magento

# Host user identity, passed as build args to php/Dockerfile so that the
# bind-mounted ./src is writable by php-fpm AND by your own account.
# Use the output of `id -u` and `id -g`.
UID=1000
GID=1000

# MySQL
# NOTE: MYSQL_ROOT_PASSWORD is only applied when the mysql_data volume is
# created. On an existing volume the stored password wins, and a mismatch here
# silently breaks the mysql healthcheck (and therefore php, which waits on it).
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=magento2
MYSQL_USER=magento
MYSQL_PASSWORD=changeme

# Canonical host ports. Override only if this machine genuinely hosts another
# service on one of them. Do NOT shift a port just because it is "in use" —
# find the owning process first (sudo ss -tulpn) so you do not end up running
# two copies of this stack at once.
MAGENTO_PORT=8080
PHP_FPM_PORT=9000
MYSQL_PORT=3306
REDIS_PORT=6379
ES_HTTP_PORT=9200
ES_TRANSPORT_PORT=9300

# Elasticsearch
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Magento
MAGENTO_VERSION=2.4.8
MAGENTO_HOST=localhost
MAGENTO_PORT=8080
