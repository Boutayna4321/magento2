{
  "info": {
    "name": "AlpineCommerce - All Modules",
    "description": "Unified REST API collection for all AlpineCommerce modules (CustomerCare, ProductReviews, ProductQuestions, Blog, LegalPages, Faq, Gdpr, EuVat, LoyaltyProgram, StorePickup, ProductLabels).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "admin_user", "value": "admin" },
    { "key": "admin_pass", "value": "Admin123!" },
    { "key": "customer_email", "value": "customer@example.com" },
    { "key": "customer_pass", "value": "Customer123!" },
    { "key": "admin_token", "value": "" },
    { "key": "customer_token", "value": "" },
    { "key": "customer_id", "value": "1" },
    { "key": "product_id", "value": "1" },
    { "key": "review_id", "value": "1" },
    { "key": "question_id", "value": "1" },
    { "key": "post_id", "value": "1" },
    { "key": "category_id", "value": "1" },
    { "key": "label_id", "value": "1" },
    { "key": "cart_id", "value": "1" },
    { "key": "store_code", "value": "default" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Get Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const token = pm.response.text().replace(/\"/g, '');",
                  "  pm.collectionVariables.set('admin_token', token);",
                  "  console.log('Admin token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_user}}\",\n  \"password\": \"{{admin_pass}}\"\n}"
            },
            "url": "{{base_url}}/rest/V1/integration/admin/token",
            "description": "Obtain admin bearer token. Saves it automatically to admin_token."
          }
        },
        {
          "name": "2. Get Customer Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const token = pm.response.text().replace(/\"/g, '');",
                  "  pm.collectionVariables.set('customer_token', token);",
                  "  console.log('Customer token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{customer_email}}\",\n  \"password\": \"{{customer_pass}}\"\n}"
            },
            "url": "{{base_url}}/rest/V1/integration/customer/token",
            "description": "Obtain customer bearer token. Saves it automatically to customer_token."
          }
        }
      ]
    },
    {
      "name": "CustomerCare",
      "item": [
        {
          "name": "GET VIP status (admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/rest/V1/customercare/vip-status/{{customer_id}}",
            "description": "Admin: getVipStatus(customerId)"
          }
        },
        {
          "name": "GET my VIP status (customer)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/rest/V1/customercare/me/vip-status",
            "description": "Customer self: getVipStatus for logged-in customer"
          }
        },
        {
          "name": "POST recalculate VIP (one customer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/rest/V1/customercare/vip-status/{{customer_id}}",
            "description": "Admin: recalculateVipStatus(customerId)"
          }
        },
        {
          "name": "POST recalculate all VIP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/rest/V1/customercare/recalculate-all",
            "description": "Admin: recalculateAll() — returns number of customers updated"
          }
        }
      ]
    },
    {
      "name": "ProductReviews",
      "item": [
        {
          "name": "GET reviews by product",
          "request": {
            "method": "GET",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/rest/V1/alphacommerce/product-reviews?productId={{product_id}}&page=1&pageSize=20",
            "description": "Anonymous: getReviews(productId, page, pageSize)"
          }
        },
        {
          "name": "GET review by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/rest/V1/alphacommerce/product-reviews/{{review_id}}",
            "description": "Anonymous: getReview(reviewId)"
          }
        },
        {
          "name": "POST add review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{product_id}},\n  \"title\": \"Great product\",\n  \"detail\": \"Really enjoyed using this product.\",\n  \"rating\": 5\n}"
            },
            "url": "{{base_url}}/rest/V1/alphacommerce/product-reviews",
            "description": "Customer self: addReview(productId, title, detail, rating)"
          }
        },
        {
          "name": "POST vote helpful",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/rest/V1/alphacommerce/product-reviews/{{review_id}}/vote?helpful=1",
            "description": "Customer self: voteHelpful(reviewId, helpful)"
          }
        }
      ]
    },
