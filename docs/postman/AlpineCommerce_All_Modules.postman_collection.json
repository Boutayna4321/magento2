{
  "info": {
    "name": "AlpineCommerce — All Modules",
    "description": "REST API collection pour tous les modules AlpineCommerce. Flow: 1) Auth/Admin Token 2) Auth/Customer Token 3) lancer les requests voulues.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "admin_user",
      "value": "admin"
    },
    {
      "key": "admin_pass",
      "value": "Admin123!"
    },
    {
      "key": "customer_email",
      "value": "customer@example.com"
    },
    {
      "key": "customer_pass",
      "value": "Customer123!"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "customer_token",
      "value": ""
    },
    {
      "key": "customer_id",
      "value": "1"
    },
    {
      "key": "post_id",
      "value": "1"
    },
    {
      "key": "category_id",
      "value": "1"
    },
    {
      "key": "faq_id",
      "value": "1"
    },
    {
      "key": "review_id",
      "value": "1"
    },
    {
      "key": "question_id",
      "value": "1"
    },
    {
      "key": "product_id",
      "value": "1"
    },
    {
      "key": "label_id",
      "value": "1"
    },
    {
      "key": "legal_page_type",
      "value": "privacy-policy"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "1. Get Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const token = pm.response.text().replace(/\"/g, '');",
                  "  pm.collectionVariables.set('admin_token', token);",
                  "  console.log('admin_token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_user}}\",\n  \"password\": \"{{admin_pass}}\"\n}"
            },
            "url": "{{base_url}}/rest/V1/integration/admin/token",
            "description": "Obtenir le Bearer token admin. Sauvegardé automatiquement dans admin_token."
          }
        },
        {
          "name": "2. Get Customer Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const token = pm.response.text().replace(/\"/g, '');",
                  "  pm.collectionVariables.set('customer_token', token);",
                  "  console.log('customer_token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{customer_email}}\",\n  \"password\": \"{{customer_pass}}\"\n}"
            },
            "url": "{{base_url}}/rest/V1/integration/customer/token",
            "description": "Obtenir le Bearer token customer. Sauvegardé automatiquement dans customer_token."
          }
        }
      ]
    },
    {
      "name": "👑 CustomerCare — VIP Status",
      "description": "Requête VipStatusInterface {customer_id, vip_level: none|bronze|silver|gold, lifetime_spent, bronze_threshold, silver_threshold, gold_threshold}",
      "item": [
        {
          "name": "GET VIP status (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rest/V1/customercare/vip-status/{{customer_id}}",
            "description": "Admin: récupère le statut VIP du customer {{customer_id}}."
          }
        },
        {
          "name": "GET my VIP status (customer self)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rest/V1/customercare/me/vip-status",
            "description": "Customer connecté: son propre statut VIP. customerId injecté depuis le token."
          }
        },
        {
          "name": "POST recalculate VIP — un customer (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rest/V1/customercare/vip-status/{{customer_id}}",
            "description": "Admin: recalcule lifetime_spent + vip_level pour le customer {{customer_id}}. Réponse: VipStatusInterface."
          }
        },
        {
          "name": "POST recalculate all VIP (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rest/V1/customercare/recalculate-all",
            "description": "Admin: recalcule le VIP de TOUS les customers. Réponse: int (nb customers mis à jour). Idéal pour cron."
          }
        }
      ]
    },
    {
