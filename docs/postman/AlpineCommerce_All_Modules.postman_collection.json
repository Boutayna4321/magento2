    {
      "name": "🔒 GDPR",
      "description": "Consent: anonymous. Export + Delete: customer self (token requis).",
      "item": [
        {
          "name": "POST log consent (anonymous)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consentType\": \"marketing_emails\",\n  \"granted\": true\n}"
            },
            "url": "{{base_url}}/rest/V1/alphacommerce/gdpr/consent",
            "description": "Enregistre un événement de consentement GDPR. consentType: marketing_emails, newsletter, analytics... Réponse: {success, message}."
          }
        },
        {
          "name": "GET export my data (customer self — Art.15)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rest/V1/alphacommerce/gdpr/export",
            "description": "Exporte toutes les données personnelles du customer connecté (GDPR Art.15)."
