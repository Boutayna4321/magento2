    {
      "name": "🇪🇺 EU VAT Validation",
      "description": "Accès public (anonymous). Valide les numéros TVA via VIES.",
      "item": [
        {
          "name": "POST validate VAT number",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"countryId\": \"FR\",\n  \"vatNumber\": \"12345678901\"\n}"
            },
            "url": "{{base_url}}/rest/V1/alphacommerce/euvat/validate",
            "description": "Valide un numéro TVA. Réponse: VatValidationInterface {entity_id, country_id, vat_number, is_valid, request_date, name, address, created_at}."
          }
        },
        {
          "name": "GET validation by country + number",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rest/V1/alphacommerce/euvat/validate/FR/12345678901",
            "description": "Récupère une validation déjà enregistrée. Remplacer FR/12345678901 par les valeurs voulues."
          }
        }
      ]
    },
